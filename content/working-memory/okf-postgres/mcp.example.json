{
  "mcpServers": {
    "okf-memory": {
      "command": "/ABSOLUTE/PATH/TO/your-project/working-memory/okf-postgres/bin/okf-memory-mcp",
      "env": {
        "OKF_REPO": "/ABSOLUTE/PATH/TO/your-project"
      }
    },
    "postgres": {
      "_comment": "Optional raw-SQL access. Use the db name from working-memory/okf-postgres/.okf-env (e.g. okf_<project>_<hash>).",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres",
               "postgresql://localhost/okf_REPLACE_FROM_okf-env"]
    }
  }
}
